# WDMWD — Environment Configuration Template
#
# 1. Copy this file:     Copy-Item .env.example .env
# 2. Fill in the required values (marked REQUIRED below)
# 3. Run:                npm run dev          # local
#                    or: docker compose up -d  # Docker
#
# The `.env` file is gitignored — NEVER commit real secrets.
# Only this example file belongs in version control.
#
# If you're running in Docker, note that `compose.yaml` overrides
# several variables (NODE_ENV, HOST, DATABASE_URL) to point at the
# container's filesystem. Those overrides win regardless of what
# you set here. See docs/deployment.md for details.

# ─── Runtime ─────────────────────────────────────────────────────
# For local development only. Docker always runs with NODE_ENV=production.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# ─── Database ────────────────────────────────────────────────────
# SQLite file path. Created automatically on first migration.
# Docker overrides this to file:/app/data/wdmwd.db (persistent volume).
DATABASE_URL=file:./data/wdmwd.db

# ─── Blockchain (REQUIRED) ──────────────────────────────────────
# Base mainnet RPC endpoint. The public default works but is rate-limited.
# For better throughput, point this at your own Base node or an Alchemy RPC URL.
BASE_RPC_URL=https://mainnet.base.org

# REQUIRED for wallet investigations.
# Get a free key at https://www.alchemy.com/
ALCHEMY_API_KEY=

# ─── AI Provider (REQUIRED) ─────────────────────────────────────
# "gemini" (default, free tier) or "openai" (paid).
AI_PROVIDER=gemini

# Gemini — free tier at https://aistudio.google.com/apikey
# REQUIRED if AI_PROVIDER=gemini. Limit: ~20 requests/day on free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI — only used if AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Agent Execution Limits ─────────────────────────────────────
# These bound how much the agent can do in a single request. Raise them
# only if you know what you're doing — each tool call costs tokens and
# increases latency.
MAX_TOOL_CALLS=8
MAX_AGENT_ITERATIONS=6
MAX_TRACE_DEPTH=5
REQUEST_TIMEOUT=60000

# ─── Access Control ─────────────────────────────────────────────
# Set to `true` ONLY if you intend to bind the server to a non-loopback
# host. WARNING: enabling this without a reverse proxy with auth exposes
# your instance and your API keys to anyone who can reach the port.
REMOTE_ACCESS=false

# ─── Local Mobile Testing (dev only) ────────────────────────────
# Comma-separated hostnames allowed to access `next dev` from a phone on
# the same network. Example: NEXT_ALLOWED_DEV_ORIGINS=192.168.1.55
# Leave empty for localhost-only. NOT used by Docker or production builds.
NEXT_ALLOWED_DEV_ORIGINS=